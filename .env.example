# Copy to .env and fill in. Never commit .env.

# How the bridge reaches Plane's API from this machine: Plane's proxy port
# (LISTEN_HTTP_PORT in Plane's plane.env, 80 by default)
PLANE_BASE_URL=http://localhost:80
# The address people click in links
PLANE_PUBLIC_URL=https://plane.example.com
# Your workspace slug: the part after plane.example.com/ in the browser
PLANE_WORKSPACE=your-workspace

# Plane: Profile settings -> Personal access tokens (or API tokens)
PLANE_API_KEY=
# Plane: Workspace settings -> Webhooks -> the secret shown when you create it (starts plane_wh_)
# Leave empty on first start; fill in after creating the Plane webhook (README step 6)
PLANE_WEBHOOK_SECRET=

# GitHub fine-grained token: resource owner = your org, Issues: Read and write
GITHUB_TOKEN=
# Any long random string; paste the same value into the GitHub org webhook
GITHUB_WEBHOOK_SECRET=
# Comma-separated GitHub owners Plane users may link repos from (e.g. your-org).
# Empty = any repo the token can reach.
GITHUB_ALLOWED_OWNERS=

# The bridge's public address from README step 5, e.g. https://hooks.example.com.
# Sync problem labels point people here for details.
BRIDGE_PUBLIC_URL=

# Seconds between membership passes: Plane sends no webhook when an existing work
# item is added to a module; this pass picks those items up. 0 turns off ALL
# background work (retry queue, checks, org scan too); only for testing.
# (BRIDGE_SYNC_INTERVAL, the old name, is still read if this is unset.)
BRIDGE_MEMBERSHIP_INTERVAL=120

# Seconds a failed action may keep retrying before it's flagged as a stuck sync problem
BRIDGE_QUEUE_MAX_AGE=300

# Seconds of quiet after the last edit to a module or repo before it's checked
BRIDGE_RECONCILE_DELAY=30

# Org-wide check of every linked module against its repo (1 = on, 0 = off).
# It schedules itself by its own cost; slow scans run in the quiet hours.
BRIDGE_ORG_SCAN=1
# IANA time zone for the quiet hours and scan slots, e.g. America/New_York
BRIDGE_TIMEZONE=UTC
# Quiet hours (start-end, 0-23) for slow scans
BRIDGE_QUIET_HOURS=1-5

# Requests per minute against Plane's API until its rate-limit headers have been
# seen (0 = no pacing until then). After that the bridge paces from the headers.
# Plane's per-key limit is API_KEY_RATE_LIMIT in Plane's plane.env (60/minute by
# default); keep this a little below it.
PLANE_RATE_LIMIT=50
# Share of each rate-limit window kept for webhooks and retries (0-1);
# scans and passes use the rest
BRIDGE_RATE_RESERVE_SHARE=0.3

LOG_LEVEL=INFO

# One-off: set to 1 and recreate the container to have the bridge re-check that
# every issue link is on its Plane item. Remove it again when the log shows no
# more "sync: repaired" lines (README: Upgrading and rolling back).
BRIDGE_RECHECK_LINKS=
