# Copy to .env and fill in. Never commit .env.

# How the bridge reaches Plane's API from this machine: Plane's proxy port
# (LISTEN_HTTP_PORT in Plane's plane.env, 80 by default)
PLANE_BASE_URL=http://localhost:80
# The address people click in links
PLANE_PUBLIC_URL=https://plane.example.com
# Your workspace slug: the part after plane.example.com/ in the browser
PLANE_WORKSPACE=your-workspace

# Plane: Profile settings -> Personal access tokens (or API tokens)
PLANE_API_KEY=
# Plane: Workspace settings -> Webhooks -> the secret shown when you create it (starts plane_wh_)
# Leave empty on first start; fill in after creating the Plane webhook (README step 6)
PLANE_WEBHOOK_SECRET=

# The bridge's public address, e.g. https://hooks.example.com. Used for the
# GitHub App's webhook URL. Empty = worked out from the request to /setup.
BRIDGE_PUBLIC_URL=

# GitHub: pick one (README step 5).
# A. One-click app: leave all four empty and open the /setup link from the log.
# B. Your own app: its ID, the private key's path inside the container (put the
#    key in ./secrets, mounted at /app/secrets), and its webhook secret.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/app/secrets/github-app.pem
# C. Fine-grained token (resource owner = your org, Issues: Read and write),
#    and any long random string for the org webhook. Also the fallback for
#    accounts an app isn't installed on.
GITHUB_TOKEN=
# B and C: the webhook secret GitHub signs deliveries with.
GITHUB_WEBHOOK_SECRET=
# Comma-separated GitHub owners Plane users may link repos from (e.g. your-org).
# Empty = any repo the token can reach.
GITHUB_ALLOWED_OWNERS=

# Seconds between catch-up syncs of linked modules (0 = off). Plane sends no webhook
# when an existing work item is added to a module; this sync picks those items up.
BRIDGE_SYNC_INTERVAL=120

LOG_LEVEL=INFO
