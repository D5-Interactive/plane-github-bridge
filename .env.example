# Copy to .env and fill in. Never commit .env.

# How the bridge reaches Plane's API (Plane's proxy on this machine)
PLANE_BASE_URL=http://localhost:8090
# The address people click in links
PLANE_PUBLIC_URL=https://plane.d5i.dev
# Your workspace slug: the part after plane.d5i.dev/ in the browser
PLANE_WORKSPACE=d5i

# Plane: Profile settings -> Personal access tokens (or API tokens)
PLANE_API_KEY=
# Plane: Workspace settings -> Webhooks -> the secret shown when you create it (starts plane_wh_)
# Leave empty on first start; fill in after creating the Plane webhook (README step 6)
PLANE_WEBHOOK_SECRET=

# GitHub fine-grained token, resource owner D5-Interactive, Issues: Read and write
GITHUB_TOKEN=
# Any long random string; paste the same value into the GitHub org webhook
GITHUB_WEBHOOK_SECRET=

LOG_LEVEL=INFO
